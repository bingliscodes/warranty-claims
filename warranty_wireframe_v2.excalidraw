    {
      "id": "hEu6vJnVJFN2OaMIIOP90",
      "type": "text",
      "x": 4869.714285714286,
      "y": 426.8571428571429,
      "width": 645,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "bMs8Mfif-f02F3wceg1Gz"
      ],
      "frameId": null,
      "index": "b0uV",
      "roundness": null,
      "seed": 943959428,
      "version": 1467,
      "versionNonce": 518971149,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795107296628,
      "created": 1795032839669,
      "link": null,
      "locked": false,
      "text": "1. Technicians submit claim info (combination of photos and free-response).\n    - Mileage and VIN extracted from a photo (fallback to manual entry)\n    - Damage photos have a free-response for description\n\n2. Upon submission reviewer (Kim) is notified\n    - Approved claim # to be added once received from company\n\n3. Submitted claim fields can be edited by reviewer\n\n4. Ongoing \"chat\" per claim between submitter and reviewer\n\n5. Photos exported together with following naming convention:\n    - ASSURANT.[last 8 of VIN].[customer last name].[photo description].[MM].[YY].jpg ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Technicians submit claim info (combination of photos and free-response).\n    - Mileage and VIN extracted from a photo (fallback to manual entry)\n    - Damage photos have a free-response for description\n\n2. Upon submission reviewer (Kim) is notified\n    - Approved claim # to be added once received from company\n\n3. Submitted claim fields can be edited by reviewer\n\n4. Ongoing \"chat\" per claim between submitter and reviewer\n\n5. Photos exported together with following naming convention:\n    - ASSURANT.[last 8 of VIN].[customer last name].[photo description].[MM].[YY].jpg ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
