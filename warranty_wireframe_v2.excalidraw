    {
      "id": "2CXwi9EsYPCsDTwNM5aP_",
      "type": "text",
      "x": 6901.62428010348,
      "y": 1280.7619047619046,
      "width": 675.37548828125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1c",
      "roundness": null,
      "seed": 1819205357,
      "version": 970,
      "versionNonce": 302263341,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795107245163,
      "created": 1795106558066,
      "link": null,
      "locked": false,
      "text": "Questions:\n- How to model Claim? I want to use a jsonb from the form data so changes to it don't break\nthe existing data model and we can extract what we need, but not sure whether it's worth\nchoosing a few key fields, then putting rest in an object\n- For the chat it doesn't really have to be real time so simple HTTP polling should work?\n- How much of auth can I leave for the future? Not sure since I've never implemented OAuth, \nbut hoping we can use anonymous persistent session cookies to start, then leave a blank field\nfor an OAuth key. However, this may require an external Auth service \n- How to rehydrate state/ensure submission process is as painless as possible?\n- How to notify reviewer on submission (email, text, eventually app push notification?) ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Questions:\n- How to model Claim? I want to use a jsonb from the form data so changes to it don't break\nthe existing data model and we can extract what we need, but not sure whether it's worth\nchoosing a few key fields, then putting rest in an object\n- For the chat it doesn't really have to be real time so simple HTTP polling should work?\n- How much of auth can I leave for the future? Not sure since I've never implemented OAuth, \nbut hoping we can use anonymous persistent session cookies to start, then leave a blank field\nfor an OAuth key. However, this may require an external Auth service \n- How to rehydrate state/ensure submission process is as painless as possible?\n- How to notify reviewer on submission (email, text, eventually app push notification?) ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
