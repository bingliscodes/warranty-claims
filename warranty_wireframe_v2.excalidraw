    },
    {
      "id": "Ev2kYUSgQEoeffgHVbvf2",
      "type": "text",
      "x": 4879.020648947647,
      "y": 995.4047619047619,
      "width": 614.8501194545202,
      "height": 520,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "EtakWTSdgPZY74fGpRH6t"
      ],
      "frameId": null,
      "index": "b0z",
      "roundness": null,
      "seed": 34239373,
      "version": 1401,
      "versionNonce": 451929037,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795107317456,
      "created": 1795104219149,
      "link": null,
      "locked": false,
      "text": "Techs submit claim info to create a new claim\nPOST /claims\nbody: {\n    formData,\n    photos\n} --> 201 \n\nRetrieve all claims\nGET /claims?customer={customer}&page={page}&limit={limit} --> Claim[]\n- Simple offset based pagination to start. May need cursor based eventually\n- Can add filters like customer later\n\nRetrieve a specific claim \nGET /claims/{id} --> Claim\n\nEdit claim fields\nPATCH /claims/{id} \nbody: {updated claim field}\n--> 200 \n\nSend message on claim thread\nPOST /claims/{id}/conversations\nbody: {message}\n\nDownload images\nGET /claims/{id}/photos --> Photo[]",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Techs submit claim info to create a new claim\nPOST /claims\nbody: {\n    formData,\n    photos\n} --> 201 \n\nRetrieve all claims\nGET /claims?customer={customer}&page={page}&limit={limit} --> Claim[]\n- Simple offset based pagination to start. May need cursor based eventually\n- Can add filters like customer later\n\nRetrieve a specific claim \nGET /claims/{id} --> Claim\n\nEdit claim fields\nPATCH /claims/{id} \nbody: {updated claim field}\n--> 200 \n\nSend message on claim thread\nPOST /claims/{id}/conversations\nbody: {message}\n\nDownload images\nGET /claims/{id}/photos --> Photo[]",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
