# Backend settings. Copy this file to backend/.env and edit as needed.
# The backend reads backend/.env when run from backend/. Every value below is
# the default, so an empty backend/.env works for local development.
#
# Lines marked [prod] must be changed for production. With APP_ENV=production
# the backend refuses to start while they still hold development values.

APP_ENV=development                     # [prod] production

DATABASE_URL=postgresql+psycopg://warranty:warranty@localhost:5432/warranty   # [prod]

SESSION_COOKIE_SECURE=false             # [prod] true (requires HTTPS)
SESSION_TTL_DAYS=365

# Addresses the browser uses. For iPhone testing, use the laptop's LAN IP
# (see README.md). In production, the https:// site address.
APP_BASE_URL=http://localhost:5173      # [prod]
ALLOWED_ORIGINS=["http://localhost:5173"]   # [prod]

# S3-compatible photo storage. The endpoint must be reachable from the browser.
S3_ENDPOINT_URL=http://localhost:9000   # [prod]
S3_REGION=us-east-1                     # [prod]
S3_BUCKET=warranty-photos               # [prod]
S3_ACCESS_KEY_ID=dev-access-key         # [prod]
S3_SECRET_ACCESS_KEY=dev-secret-key     # [prod]
MAX_UPLOAD_BYTES=30000000

# Reviewer email. Mailpit catches everything locally (http://localhost:8025).
SMTP_HOST=localhost                     # [prod]
SMTP_PORT=1025                          # [prod]
# Unset means no SMTP login. Set both for a real provider.
# SMTP_USERNAME=                        # [prod]
# SMTP_PASSWORD=                        # [prod]
SMTP_STARTTLS=false                     # [prod]
MAIL_FROM=warranty-app@localhost        # [prod]

VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api
